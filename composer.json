{
	"name": "joserick/png-metadata",
	"description": "A PHP library for extract the metadata (XMP, EXIF) within a PNG format image.",
	"keywords": [
		"metadata",
		"png",
		"exif",
		"xmp",
		"exiftool"
	],
	"type": "library",
	"license": "GPL-3.0-only",
	"authors": [
		{
			"name": "Jóse Erick Carreón",
			"email": "joserick.92@gmail.com",
			"homepage": "https://github.com/joserick"
		},
		{
			"name": "Jan Barášek",
			"homepage": "https://baraja.cz"
		}
	],
	"require": {
		"php": "^8.3",
		"ext-exif": "*",
		"ext-mbstring": "*",
		"ext-xml": "*",
		"ext-zlib": "*"
	},
	"require-dev": {
		"phpstan/phpstan": "^2.0",
		"phpunit/phpunit": "^11.0",
		"roave/security-advisories": "dev-latest"
	},
	"autoload": {
		"psr-4": {
			"PNGMetadata\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"PNGMetadata\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "vendor/bin/phpunit --testsuite unit",
		"test:performance": "php -d memory_limit=512M vendor/bin/phpunit --testsuite unit --group performance",
		"test:integration": "vendor/bin/phpunit --testsuite integration",
		"coverage": "vendor/bin/phpunit --testsuite unit --coverage-text --coverage-clover coverage.xml",
		"phpstan": "vendor/bin/phpstan analyse -c phpstan.neon --no-progress"
	},
	"minimum-stability": "stable",
	"extra": {
		"branch-alias": {
			"dev-master": "2.x-dev"
		}
	}
}
